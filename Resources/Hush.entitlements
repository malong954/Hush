<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Hush (required for notarization).
  - audio-input: reading process taps counts as audio input under the hardened runtime.
  Not sandboxed on purpose: Hush reads simulator device folders and other processes' audio
  attribution, which the App Sandbox blocks (so Hush ships outside the Mac App Store).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
